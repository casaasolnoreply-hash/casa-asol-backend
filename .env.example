# ─────────────────────────────────────────────
#  CASA ASOL — Plantilla backend
#  Copia como ".env" y rellena los valores
# ─────────────────────────────────────────────

PORT=3001

# ── JWT (firma asimétrica RS256) ───────────────────────────
# Genera un par nuevo con este comando y pega cada línea aquí:
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});const e=s=>s.trim().split(String.fromCharCode(10)).join('\\n');console.log('JWT_PRIVATE_KEY='+e(privateKey));console.log('JWT_PUBLIC_KEY='+e(publicKey));"
# Requeridas: el backend no arranca sin ellas. Nunca compartas JWT_PRIVATE_KEY.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

ADMIN_USER=admin
ADMIN_PASS=tu_contrasena_segura

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

NODE_ENV=development

# "true" borra y recrea la BD desde config/schema.js al arrancar
# (se ignora automáticamente si NODE_ENV=production)
RESET_DB=false

# Client ID de Google Cloud (OAuth). Vacío = botón de Google desactivado.
GOOGLE_CLIENT_ID=

# Envío de correo vía Google Apps Script. Ver
# backend/scripts/apps-script-mailer.gs para el código y las
# instrucciones de despliegue. Vacío = no se manda correo (se
# muestra la contraseña generada en el panel como respaldo).
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_TOKEN=
MAIL_SENDER_NAME=Casa ASOL
